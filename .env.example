# ---- apps/api (runtime env vars on the api container) ----
PORT=3001
NODE_ENV=production
# One database + one LOGIN NOSUPERUSER role per project
DATABASE_URL=postgres://baseline:CHANGE_ME@db-host:5432/baseline
# openssl rand -hex 32
BETTER_AUTH_SECRET=CHANGE_ME
# Public origin of the API (Better Auth baseURL)
BETTER_AUTH_URL=https://baseline.joemarkgimeno.com
# Comma-separated browser origins allowed to call the API (CORS + Better Auth trusted origins)
WEB_ORIGINS=https://baseline.joemarkgimeno.com
# Leave empty: web and API share one origin (nginx proxies /graphql and /api/), so the cookie is host-only
COOKIE_DOMAIN=
# Optional Google sign-in: both must be set or the provider is not registered
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Rate limits (feature 003): attempts per window (seconds). All optional; shown with defaults.
RATE_LIMIT_SIGN_IN_MAX=5
RATE_LIMIT_SIGN_IN_WINDOW=60
RATE_LIMIT_LINKS_MAX=10
RATE_LIMIT_LINKS_WINDOW=60
RATE_LIMIT_GENERAL_MAX=300
RATE_LIMIT_GENERAL_WINDOW=60
# Headers the caller's address is read from, in order (single-valued ones only). Behind a CDN such as Cloudflare, keep cf-connecting-ip first.
CLIENT_IP_HEADERS=cf-connecting-ip,x-forwarded-for

# ---- apps/web (build-time args; Vite inlines VITE_* at build) ----
VITE_API_URL=https://baseline.joemarkgimeno.com
VITE_ENABLE_GOOGLE_AUTH=false
