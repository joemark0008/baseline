{
  "name": "@baseline/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "React + Vite + TanStack Router + shadcn/ui web app with Better Auth and Apollo",
  "scripts": {
    "dev": "vite --port 4173",
    "predev": "npm run codegen",
    "build": "npm run codegen && vite build && tsc --noEmit -p tsconfig.json",
    "preview": "vite preview --port 4173",
    "typecheck": "npm run codegen && tsc --noEmit -p tsconfig.json",
    "test": "npm run codegen && vitest run",
    "test:watch": "vitest",
    "codegen": "graphql-codegen --config codegen.ts",
    "routes:generate": "tsr generate"
  },
  "dependencies": {
    "@apollo/client": "^4.0.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@radix-ui/react-slot": "^1.2.0",
    "@tanstack/react-router": "^1.170.46",
    "better-auth": "^1.7.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "graphql": "^16.11.0",
    "lucide-react": "^1.0.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^8.0.0",
    "@graphql-codegen/client-preset": "^7.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/router-cli": "^1.168.0",
    "@tanstack/router-plugin": "^1.169.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
