/// One-time password reset link created by an Admin (feature 002). Only the token's hash is kept.
model PasswordResetLink {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("PasswordResetLinkUser", fields: [userId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?     @relation("PasswordResetLinkCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_link")
}
