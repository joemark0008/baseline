// Invitation-only sign-up (feature module `invites`).

model Invite {
  id          String    @id @default(cuid())
  email       String
  roleId      String
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  tokenHash   String
  invitedById String
  invitedBy   User      @relation("InviteInvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  /// Set when the invite also joins an implementation project on acceptance (feature 007).
  projectId   String?
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectRole ProjectRole?

  @@unique([tokenHash])
  @@index([projectId])
  @@index([email])
  @@map("invite")
}
