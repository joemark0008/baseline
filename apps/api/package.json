{
  "name": "@his_project_planner/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS GraphQL API with Better Auth and Prisma",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch --preserveWatchOutput",
    "start:debug": "nest start --debug --watch",
    "start:prod": "prisma migrate deploy && node dist/main.js",
    "dev": "npm run start:dev",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "setup:token": "tsx src/setup-token.ts",
    "setup:token:prod": "node dist/setup-token.js",
    "schema:generate": "nest build && node dist/schema.generate.js",
    "g": "nest g --format"
  },
  "dependencies": {
    "@apollo/server": "^5.5.2",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^14.2.1",
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/graphql": "^14.2.1",
    "@nestjs/platform-express": "^12.5.1",
    "@nestjs/throttler": "^6.8.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@thallesp/nestjs-better-auth": "^2.8.0",
    "better-auth": "^1.7.27",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "graphql": "^16.11.0",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@nestjs/schematics": "^12.0.16",
    "@nestjs/testing": "^12.5.1",
    "@swc/core": "^1.15.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.0"
  },
  "type": "module"
}
